{
  "FileBackuperSwitch": {
    "_commentLevels": "Допустимые уровни: Off, Error, Warning, Info, Verbose.",
    "_commentOff": "Off — отключить журналирование.",
    "_commentError": "Error — только ошибки.",
    "_commentWarning": "Warning — ошибки и предупреждения.",
    "_commentInfo": "Info — обычный журнал.",
    "_commentVerbose": "Verbose — полный журнал, включая найденные и пропущенные файлы и их приоритеты.",
    "Level": "Verbose"
  },
  "Backup": {
    "ShowConsole": true,
    "StateDirectory": "",
    "DrivePollingIntervalSeconds": 5,
    "MonitorNewDrives": true,
    "DestinationDirectory": "",
    "ScanDirectory": null,
    "MinFileSizeBytes": 10000,
    "MaxFileSizeBytes": 4000000000,
    "EnableExifAnalysis": true,
    "FileSizeGroups": [
      {
        "Name": "Small",
        "MinBytes": 10000,
        "MaxBytes": 204800
      },
      {
        "Name": "Medium",
        "MinBytes": 204801,
        "MaxBytes": 10485760
      },
      {
        "Name": "Large",
        "MinBytes": 10485761,
        "MaxBytes": 104857600
      },
      {
        "Name": "VeryLarge",
        "MinBytes": 104857601,
        "MaxBytes": 1073741824
      },
      {
        "Name": "Huge",
        "MinBytes": 1073741825,
        "MaxBytes": 4000000000
      }
    ],
    "IncludeBrowserCaches": true,
    "CloudFileMode": "FastSkip",
    "SkipDirectoryNames": [
      "Windows",
      "Program Files",
      "Program Files (x86)",
      "ProgramData",
      "AppData"
    ]
  }
}
